PORT=3000

# Set to 'true' in production to actually send FCM push notifications
SEND_FCM=false

# Admin dashboard access token
# Generate: node -e "import('crypto').then(c=>console.log(c.randomBytes(32).toString('hex')))"
ADMIN_TOKEN=your_random_token_here

# JWT signing secret for DeepSeek proxy tokens (15-min lifetime)
# Generate: node -e "import('crypto').then(c=>console.log(c.randomBytes(48).toString('hex')))"
JWT_SECRET=your_jwt_secret_here

# DeepSeek API key — injected server-side, never exposed to clients
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Free trial limits (overridden by admin panel Firestore settings when set)
FREE_TRIAL_PROMPTS_MAX=15
FREE_TRIAL_WINDOW_DAYS=7

# Telegram bot that posts a message for every new install (both optional;
# alerts are off when either is empty). Chat id: message the bot, then open
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Daily and on-demand analytics analysis (BigQuery GA4 export read by a view-only
# service account, insights by DeepSeek). Alerts need the Telegram vars above.
ANALYTICS_DEEPSEEK_API_KEY=
GA_BQ_PROJECT=
GA_BQ_DATASET=
# Optional: ANALYTICS_DEEPSEEK_MODEL (default deepseek-chat), PUBLIC_BASE_URL
# Optional: ANALYTICS_US_USER_CAP (default 15) caps how many US users the analysis counts.
